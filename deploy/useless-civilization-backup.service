[Unit]
Description=Back up Useless Civilization SQLite
After=useless-civilization.service

[Service]
Type=oneshot
User=civilization
Group=civilization
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=DATABASE_PATH=/var/lib/useless-civilization/town.sqlite
Environment=BACKUP_DIRECTORY=/var/backups/useless-civilization
WorkingDirectory=/opt/useless-civilization
ExecStart=/usr/bin/env node /opt/useless-civilization/server/daily-backup.mjs
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/useless-civilization /var/backups/useless-civilization
