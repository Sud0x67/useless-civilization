useless-llm.com {
    # Event streams must remain uncompressed so the first event reaches browsers immediately.
    @compressible not path /api/stream
    encode @compressible zstd gzip
    reverse_proxy 127.0.0.1:4180 {
        # Overwrite client-supplied identity headers. Node only trusts this on loopback.
        header_up X-Real-IP {remote_host}
    }
}
