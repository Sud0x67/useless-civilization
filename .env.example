# 复制为 .env，所有居民决策默认由模型生成。密钥不发送到浏览器，也不提交 Git。
LLM_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.8-flash
LLM_WIRE_API=responses
LLM_API_KEY=请填写你的密钥
PORT=4180
# Chat Completions 兼容服务可设置 LLM_WIRE_API=chat。

# 默认：服务器权威共享小镇。Cookie 仅保存匿名身份，状态在服务器 SQLite。
DATABASE_PATH=data/town.sqlite
MODEL_CALLS_PER_MINUTE=6
MODEL_CALLS_PER_DAY=500
TOWN_INTERVAL_MS=20000
# 管理员 token 使用 node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))" 生成。
ADMIN_TOKEN=请替换为随机管理员令牌
# 上线后填写域名，只有通过本机反向代理访问时才开启 TRUST_PROXY。
# PUBLIC_ORIGIN=https://useless-llm.com
# TRUST_PROXY=1
# 仅本机旧版单人预览/自动化回归测试可设置 LOCAL_PREVIEW=1。
